{
  "name": "@echo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "clean": "rm -rf .next .turbo *.tsbuildinfo",
    "dev": "next dev --turbopack",
    "prebuild": "bun run scripts/sync-onnx-runtime.ts && bun run scripts/sync-pglite-runtime.ts",
    "predev": "bun run scripts/sync-onnx-runtime.ts && bun run scripts/sync-pglite-runtime.ts",
    "start": "bun x serve@latest out",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "^10.0.1",
    "@echo/core": "workspace:*",
    "@echo/db": "workspace:*",
    "@echo/embeddings": "workspace:*",
    "@echo/learning": "workspace:*",
    "@echo/parser": "workspace:*",
    "@echo/search": "workspace:*",
    "@echo/types": "workspace:*",
    "@echo/ui": "workspace:*",
    "@electric-sql/pglite": "^0.5.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "next": "latest",
    "onnxruntime-web": "^1.29.0",
    "react": "latest",
    "react-dom": "latest",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@echo/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "latest",
    "@types/bun": "^1.4.0",
