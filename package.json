{
  "name": "echo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=!@echo/desktop",
    "dev:web": "turbo run dev --filter=@echo/web",
    "dev:www": "turbo run dev --filter=@echo/www",
    "build": "turbo run build",
    "start": "bun run --cwd apps/web start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build:desktop": "bun run --cwd apps/desktop package"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "^1.4.0",
    "turbo": "latest",
    "typescript": "latest"
  }
}
